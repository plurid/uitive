{
  "name": "uitive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build",
    "lint": "eslint --config tools/config/eslint.config.mjs .",
    "format": "prettier --write --ignore-path .gitignore --ignore-path tools/config/prettier-ignore .",
    "format:check": "prettier --check --ignore-path .gitignore --ignore-path tools/config/prettier-ignore .",
    "docs": "node tools/build/docs.ts",
    "typecheck": "pnpm build && pnpm --filter \"./apps/*\" -r --if-present typecheck && tsc -p tools/config/tsconfig.tests.json",
    "test": "vitest run --config tools/config/vitest.config.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "prettier": "3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "zod": "^4.6.5"
  }
}
