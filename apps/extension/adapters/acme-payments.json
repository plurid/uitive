      "nav.home": {
        "label": "Home",
        "description": "Opens Home from the sidebar",
        "group": "Sidebar"
      },
      "nav.funds": {
        "label": "Funds",
        "description": "Opens Funds from the sidebar",
        "group": "Sidebar"
      },
      "nav.payments": {
        "label": "Payments",
        "description": "Opens Payments from the sidebar",
        "group": "Sidebar"
      },
      "nav.customers": {
        "label": "Customers",
        "description": "Opens Customers from the sidebar",
        "group": "Sidebar"
      },
      "nav.catalog": {
        "label": "Catalog",
        "description": "Opens Catalog from the sidebar",
        "group": "Sidebar"
      },
      "nav.partners": {
        "label": "Partners",
        "description": "Opens Partners from the sidebar",
        "group": "Sidebar"
      },
      "nav.invoices": {
        "label": "Invoices",
