{
  "extends": "../../tools/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@plurid/uitive-core": ["../../packages/core/src/index.ts"],
      "@plurid/uitive-react": ["../../packages/react/src/index.ts"],
      "@plurid/uitive-dom": ["../../packages/dom/src/index.ts"],
      "@plurid/uitive-dom/*": ["../../packages/dom/src/*"],
      "@plurid/uitive-server": ["../../packages/server/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
