{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@plurid/uitive-core": ["../../packages/core/src/index.ts"],
      "@plurid/uitive-react": ["../../packages/react/src/index.ts"],
      "@plurid/uitive-dom": ["../../packages/dom/src/index.ts"],
      "@plurid/uitive-dom/*": ["../../packages/dom/src/*"],
      "@plurid/uitive-planner": ["../../packages/planner/src/index.ts"],
      "@plurid/uitive-planner/*": ["../../packages/planner/src/*"],
      "@plurid/uitive-adapter": ["../../packages/adapter/src/index.ts"],
      "@plurid/uitive-server": ["../../packages/server/src/index.ts"],
      "@plurid/uitive-server/*": ["../../packages/server/src/*"],
      "uitive": ["../../packages/cli/src/index.ts"],
      "@plurid/uitive-mcp": ["../../packages/mcp/src/index.ts"]
    }
  },
  "include": [
    "../**/*.ts",
    "../**/*.tsx",
    "../../packages/*/src/**/*.test.ts",
    "../../packages/*/src/**/*.test.tsx",
    "../../docs/examples/**/*.ts",
    "../../docs/examples/**/*.tsx"
  ]
}
