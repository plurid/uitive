  "components": {
    "securitySchemes": {
      "key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-acme-key",
        "description": "A key starting acme_test_ for test data, or acme_live_ for live data. Secret keys, starting acme_secret_, are refused."
      }
    },
    "schemas": {
      "charge": {
        "type": "object",
        "title": "Charge",
        "description": "One attempt to take a payment from a customer's card.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the object."
          },
          "object": {
            "type": "string",
            "enum": ["charge"]
          },
          "amount": {
            "type": "integer",
            "description": "Amount the payment asked for, in the currency's smallest unit (cents for euros)."
          },
          "amount_refunded": {
            "type": "integer",
            "description": "Amount refunded, in the currency's smallest unit (cents for euros)."
          },
          "currency": {
            "type": "string",
            "format": "currency",
            "description": "Three-letter ISO currency code, in lowercase."
          },
          "status": {
            "type": "string",
            "enum": ["failed", "succeeded"]
          },
          "created": {
            "type": "integer",
            "format": "unix-time",
            "description": "When the object was created, in seconds since the Unix epoch."
          },
          "customer": {
            "anyOf": [
              {
