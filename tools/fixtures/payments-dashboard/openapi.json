{
  "openapi": "3.1.0",
  "info": {
    "title": "Acme Payments API",
    "version": "2026-10-10",
    "description": "The API of Acme Payments, a fictional payments dashboard for testing Uitive's extension. Read-only: lists page newest first with starting_after, and each object reads by its ID."
  },
  "servers": [
    {
      "url": "https://api.acme-payments.example"
    }
  ],
  "security": [
    {
      "key": []
    }
  ],
  "paths": {
    "/v1/charges": {
      "get": {
        "operationId": "ListCharges",
        "summary": "List payments",
        "parameters": [
          {
            "name": "created",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "description": "Only objects created in this range.",
            "schema": {
              "anyOf": [
                {
                  "type": "object",
                  "title": "range",
                  "properties": {
                    "gt": {
                      "type": "integer"
                    },
                    "gte": {
                      "type": "integer"
                    },
                    "lt": {
                      "type": "integer"
                    },
                    "lte": {
                      "type": "integer"
                    }
                  }
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          {
            "name": "customer",
            "in": "query",
            "description": "Only payments by this customer.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many objects to return, from 1 to 100.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "starting_after",
            "in": "query",
            "description": "The ID of the last object of the previous page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of objects, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "ChargeList",
                  "required": ["data", "has_more", "object", "url"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/charge"
                      }
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "object": {
                      "type": "string",
                      "enum": ["list"]
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
