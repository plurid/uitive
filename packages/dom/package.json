{
  "name": "@plurid/uitive-dom",
  "version": "0.1.1",
  "description": "Plain-HTML bindings and framework-agnostic web components for Uitive",
  "keywords": [
    "uitive",
    "adaptive-ui",
    "llm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/plurid/uitive/tree/master/packages/dom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plurid/uitive.git",
    "directory": "packages/dom"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "import": "./dist/debug.js",
      "default": "./dist/debug.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/build/clean.mjs dom && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@plurid/uitive-core": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "zod": "^4.6.5"
  },
  "bugs": {
    "url": "https://github.com/plurid/uitive/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
