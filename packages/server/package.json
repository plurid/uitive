{
  "name": "@plurid/uitive-server",
  "version": "0.1.0",
  "description": "Fetch-standard handler and Claude planner for Uitive",
  "keywords": [
    "uitive",
    "adaptive-ui",
    "llm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/plurid/uitive/tree/master/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plurid/uitive.git",
    "directory": "packages/server"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/build/clean.mjs server && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@plurid/uitive-core": "workspace:^",
    "@plurid/uitive-planner": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "zod": "^4.6.5"
  }
}
